{
  "name": "preset-lab",
  "version": "0.1.0",
  "private": true,
  "description": "PRESET LAB — marketplace de presets fotográficos",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "test:sql": "bash scripts/test-migrations.sh",
    "assets:generate": "node scripts/generate-assets.mjs",
    "admin:promote": "node scripts/promote-admin.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.80.0",
    "motion": "^12.43.0",
    "next": "^15.5.29",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
