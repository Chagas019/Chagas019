# ============================================================================
# PRESET LAB — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou configure na Vercel (produção).
# NUNCA coloque a service role key em variáveis NEXT_PUBLIC_*.
# ============================================================================

# URL pública do site (links de e-mail, retorno do pagamento, webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend de dados: "supabase" (produção) ou "local" (demonstração/desenvolvimento).
# Se omitido: usa Supabase quando as variáveis abaixo existirem; senão, local.
# DATA_BACKEND=local

# --- Supabase (Settings → API) ----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Usada para confirmar pagamentos, registrar downloads e gerar URLs assinadas.
SUPABASE_SERVICE_ROLE_KEY=

# --- Pagamentos --------------------------------------------------------------
# "mercadopago" (real) ou "dev" (checkout SIMULADO; bloqueado em produção).
# Se omitido: mercadopago quando MP_ACCESS_TOKEN existir; senão, dev.
# PAYMENTS_PROVIDER=dev
# Mercado Pago → Suas integrações → Credenciais de produção (Access Token)
MP_ACCESS_TOKEN=
# Mercado Pago → Suas integrações → Webhooks → "Assinatura secreta"
MP_WEBHOOK_SECRET=

# --- Segurança ---------------------------------------------------------------
# Segredo (≥ 32 caracteres) para tokens do modo local. Gere com: openssl rand -hex 32
APP_SECRET=

# Somente testes E2E: permite o modo local/simulado em `next start` (NODE_ENV=production).
# NUNCA ative em um deploy público.
# ALLOW_LOCAL_DEMO=true
