# ---------------------------------------------------------------- App
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Google Cloud (OAuth 2.0 Client ID, tipo "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Segurança
# 32 bytes em base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Segredo do agendador (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>"): openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------- IA
# Na Vercel nada é necessário: usa a Vercel AI Gateway com o token OIDC do deploy.
# Fora da Vercel, defina UMA das opções:
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
# Model routing: econômico para triagem/perguntas simples, mais capaz para análise e resumo semanal
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
