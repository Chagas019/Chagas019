# ======================= SOCIAL AI — variáveis de ambiente =======================
# Copie para .env e preencha. NUNCA versione o arquivo .env.

NODE_ENV=production
PORT=8080
TZ_APP=America/Sao_Paulo

# Banco e arquivos (use um volume persistente)
DATABASE_PATH=./storage/social-ai.db
STORAGE_DIR=./storage
BACKUP_DIR=./backups

# URL pública HTTPS do painel/servidor. A Graph API baixa as mídias por esta URL.
PUBLIC_BASE_URL=https://social.seudominio.com.br

# Segredos (gere com: npm run key:generate)
ENCRYPTION_KEY=
SESSION_SECRET=

# Primeiro administrador (criado só se não existir nenhum usuário). Senha >= 12 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Claude (cérebro dos agentes)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high

# App Meta (Instagram API com Login do Facebook)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://social.seudominio.com.br/api/instagram/oauth/callback
META_GRAPH_VERSION=v24.0
# Alternativa ao OAuth: token de longa duração já emitido (opcional)
IG_ACCESS_TOKEN=
IG_USER_ID=

# Geração de imagens (opcional): none | openai
IMAGE_GEN_PROVIDER=none
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=gpt-image-1

# TRAVA DE INFRAESTRUTURA: só com "true" o sistema pode publicar de verdade.
# Além disso é preciso ligar o "Modo de produção" no painel (com checklist + confirmação).
ALLOW_PUBLISHING=false

WORKER_ENABLED=true
SCHEDULER_ENABLED=true
LOG_LEVEL=info
