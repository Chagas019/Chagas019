{
  "name": "social-ai",
  "version": "1.0.0",
  "private": true,
  "description": "SOCIAL AI — agência digital autônoma para gestão do Instagram",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/cli/migrate.ts",
    "preview": "tsx src/cli/preview.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "admin:create": "tsx src/cli/create-admin.ts",
    "backup": "tsx src/cli/backup.ts",
    "key:generate": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "fastify": "^5.12.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
