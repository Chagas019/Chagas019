# ── Supabase (autenticação + banco). Público: URL e chave anon/publishable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Somente no servidor (nunca use o prefixo NEXT_PUBLIC_)
# Assistente de pregação (Claude, Anthropic)
ANTHROPIC_API_KEY=
# Modelo opcional (padrão: claude-opus-5-5)
VERBUM_AI_MODEL=
# Busca de vídeos de pregações e músicas no YouTube (YouTube Data API v3)
YOUTUBE_API_KEY=
# Limite mensal de gerações de IA no plano gratuito (padrão: 10)
VERBUM_FREE_AI_LIMIT=10
