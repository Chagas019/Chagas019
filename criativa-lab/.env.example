# ───────────── CRIATIVA LAB — variáveis de ambiente ─────────────
# Copie para .env.local e preencha. Sem as variáveis do Supabase,
# a plataforma roda em MODO LOCAL (dados salvos no navegador).

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IA do Gerador de Ideias (fica só no servidor, nunca vai ao navegador)
# Sem a chave, o gerador usa o motor criativo local.
ANTHROPIC_API_KEY=
# Opcional: trocar o modelo (padrão: claude-opus-5-5)
ANTHROPIC_MODEL=
