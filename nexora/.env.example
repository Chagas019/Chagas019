# Copie para .env.local e preencha para conectar ao Supabase.
# Sem estas variáveis o site roda em MODO DEMONSTRAÇÃO (dados locais, sem login real).
# Use SOMENTE a chave pública "anon". Nunca coloque a service_role key no frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Endereço público do site (canonical, Open Graph e sitemap). Ex.: https://nexora.exemplo.com.br
VITE_SITE_URL=
