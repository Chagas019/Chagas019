# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# A chave "anon" é pública por design: a proteção vem das políticas RLS do banco.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
# URL pública do site (usada nos e-mails de confirmação e recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NUNCA coloque a service_role key em variáveis NEXT_PUBLIC_*.
