# Copie para .env e preencha. Nunca faça commit do .env.
# Nada aqui é lido pelo navegador: variáveis NEXT_PUBLIC_* não são usadas para segredos.

# --- Fase 2 (site) ---
PORT=3000

# --- Fase 3 (API, banco e cache) ---
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=
DATABASE_URL=postgres://nexus:TROQUE@localhost:5432/nexus
REDIS_PASSWORD=
REDIS_URL=redis://:TROQUE@localhost:6379
# Segredo para assinar sessões (gere com: openssl rand -base64 48)
SESSION_SECRET=
# Envio de e-mail (verificação e recuperação de conta)
SMTP_URL=
MAIL_FROM="NEXUS <nao-responda@exemplo.com>"

# --- Fase 4 (streaming) ---
# Segredo compartilhado com o coturn para credenciais TURN temporárias
TURN_SECRET=
TURN_URLS=turn:turn.exemplo.com:3478
# Chave para assinar ordens enviadas aos nós de jogo
NODE_SIGNING_KEY=

# --- Fase 5 (Steam) ---
# Chave da Steam Web API (só metadados públicos; o login usa OpenID e nunca pede senha)
STEAM_WEB_API_KEY=
