  "narration": [
    {
      "id": "n01",
      "start": 5.0,
      "end": 7.4,
      "text": "Às vezes, tudo começa com um olhar.",
      "caption": false,
      "direction": "Quase sussurrado. Voz próxima do microfone, sem pressa."
    },
    {
      "id": "n02",
      "start": 8.4,
      "end": 9.6,
      "text": "Uma imagem.",
      "direction": "Pausa curta antes e depois."
    },
    {
      "id": "n03",
      "start": 10.1,
      "end": 11.1,
      "text": "Um instante.",
      "direction": "Mais baixo que a frase anterior."
    },
    {
      "id": "n04",
      "start": 11.8,
      "end": 16.4,
      "text": "A vontade de guardar aquilo que o tempo parece querer levar embora.",
      "direction": "Leve saudade. Alongue \"embora\"."
    },
    {
      "id": "n05",
      "start": 17.4,
      "end": 19.7,
      "text": "Mas, em algum momento, percebemos...",
      "direction": "Virada. Respire antes de \"percebemos\" e deixe as reticências soarem."
    },
    {
      "id": "n06",
      "start": 20.6,
      "end": 23.4,
      "text": "que não se tratava apenas de fotografar.",
      "caption": false,
      "direction": "Firme e calmo. Depois, silêncio de 2 a 3 segundos."
    },
    {
      "id": "n07",
      "start": 26.0,
      "end": 30.4,
      "text": "Porque Deus também nos chama através daquilo que colocamos a serviço.",
      "direction": "Testemunho, não pregação. Destaque leve em \"chama\"."
    },
    {
      "id": "n08",
      "start": 31.4,
      "end": 34.2,
      "text": "Talvez tenha começado com uma câmera.",
      "direction": "Lembrança pessoal, quase um sorriso."
    },
    {
      "id": "n09",
      "start": 34.6,
      "end": 36.0,
      "text": "Talvez com um vídeo.",
      "direction": "Mesmo tom, ritmo de enumeração."
    },
    {
      "id": "n10",
      "start": 36.4,
      "end": 39.7,
      "text": "Talvez com a vontade de comunicar alguma coisa.",
      "direction": "Abre um pouco a voz."
    },
    {
      "id": "n11",
      "start": 40.7,
      "end": 45.8,
      "text": "Mas o chamado nunca foi apenas sobre aquilo que estava diante das nossas lentes.",
      "direction": "Começa o crescimento emocional. Sem acelerar."
    },
    {
      "id": "n12",
      "start": 46.7,
      "end": 48.3,
      "text": "Era sobre as pessoas.",
      "direction": "Simples, sincero."
    },
    {
      "id": "n13",
      "start": 48.7,
      "end": 50.1,
      "text": "Sobre os encontros.",
      "direction": ""
    },
    {
      "id": "n14",
      "start": 50.5,
      "end": 53.5,
      "text": "Sobre as histórias que Deus escreve em silêncio.",
      "direction": "Diminua na palavra \"silêncio\". A música para logo depois."
    },
    {
      "id": "n15",
      "start": 55.7,
      "end": 58.7,
      "text": "Somos chamados a algo maior do que fotografias.",
      "caption": false,
      "direction": "O coração do filme. Voz plena, sem gritar. Entra junto com o tutti da música."
    },
    {
      "id": "n16",
      "start": 59.5,
      "end": 60.7,
      "text": "Maior do que vídeos.",
      "direction": "Ritmo marcado, acompanhando os cortes."
    },
    {
      "id": "n17",
      "start": 61.0,
      "end": 62.4,
      "text": "Maior do que curtidas.",
      "caption": false,
      "direction": ""
    },
    {
      "id": "n18",
      "start": 62.8,
      "end": 64.2,
      "text": "Maior do que números.",
      "caption": false,
      "direction": "Feche a enumeração descendo o tom."
    },
    {
      "id": "n19",
      "start": 65.3,
      "end": 67.0,
      "text": "Somos chamados a servir.",
      "direction": "Convicção serena. Pausa depois."
    },
    {
      "id": "n20",
      "start": 68.2,
      "end": 70.5,
      "text": "A transformar técnica em serviço.",
      "caption": false,
      "direction": "Cada par de palavras é uma decisão."
    },
    {
      "id": "n21",
      "start": 70.9,
      "end": 72.6,
      "text": "Criatividade em missão.",
      "caption": false,
      "direction": ""
    },
    {
      "id": "n22",
      "start": 73.0,
      "end": 74.9,
      "text": "Comunicação em encontro.",
      "caption": false,
      "direction": ""
    },
    {
      "id": "n23",
      "start": 75.3,
      "end": 77.6,
      "text": "E imagens em testemunhos de fé.",
      "direction": "Ponto alto da sequência. Destaque em \"fé\"."
    },
    {
      "id": "n24",
      "start": 78.6,
      "end": 82.5,
      "text": "Porque, quando colocamos nossos dons a serviço do Reino de Deus,",
      "direction": "Mais íntimo, a música abre espaço."
    },
    {
      "id": "n25",
      "start": 82.8,
      "end": 88.1,
      "text": "até aquilo que parece pequeno pode se tornar instrumento de evangelização.",
      "direction": "Conclusão do ato. Termine com segurança, sem cair o tom."
    },
    {
      "id": "n26",
      "start": 90.1,
      "end": 93.8,
      "text": "Talvez nem todos se lembrem de quem estava atrás da câmera.",
      "direction": "Humildade. A música desacelera."
    },
    {
      "id": "n27",
      "start": 94.6,
      "end": 98.8,
      "text": "Talvez ninguém saiba quantas horas foram dedicadas àquela imagem.",
      "direction": "Sem queixa: é constatação serena."
    },
    {
      "id": "n28",
      "start": 99.8,
      "end": 104.2,
      "text": "Mas, se através daquilo que comunicamos, alguém se sentir acolhido...",
      "direction": "Abre a esperança. Reticências reais."
    },
    {
      "id": "n29",
      "start": 104.8,
      "end": 107.1,
      "text": "se alguém reencontrar a esperança...",
      "direction": ""
    },
    {
      "id": "n30",
      "start": 107.7,
      "end": 110.0,
      "text": "se alguém se aproximar de Cristo...",
      "direction": "A frase mais delicada. Quase em oração."
    },
    {
      "id": "n31",
      "start": 110.9,
      "end": 113.7,
      "text": "então nossa missão terá valido a pena.",
      "direction": "Resolução. Leve sorriso na voz."
    },
    {
      "id": "n32",
