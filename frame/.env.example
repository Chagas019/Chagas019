# --- Obrigatórias ---
# PostgreSQL (local, Neon, Supabase, RDS…). Neon tem plano gratuito.
DATABASE_URL=postgres://frame:frame@localhost:5432/frame
# Segredo da sessão (gere com: openssl rand -base64 32)
BETTER_AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
# URL pública da aplicação
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Armazenamento de mídia ---
# "local" (disco, apenas desenvolvimento/self-host) ou "blob" (Vercel Blob, store privada)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# BLOB_READ_WRITE_TOKEN=   # exigido quando STORAGE_DRIVER=blob

# --- FRAME AI (opcional; sem chave a IA fica desativada com aviso claro) ---
# Modelo no formato "provedor/modelo". Com AI_GATEWAY_API_KEY usa o Vercel AI Gateway;
# com ANTHROPIC_API_KEY ou OPENAI_API_KEY usa o provedor direto correspondente.
FRAME_AI_MODEL=anthropic/claude-haiku-5-5
# AI_GATEWAY_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Limite diário de requisições por usuário e teto diário global estimado em USD
FRAME_AI_DAILY_LIMIT=30
FRAME_AI_GLOBAL_DAILY_BUDGET_USD=5

# --- Regras de comunidade ---
# Idade mínima da conta (horas) para votar em desafios (anti-abuso)
CHALLENGE_MIN_ACCOUNT_AGE_HOURS=24
# E-mails que recebem papel de administrador ao se cadastrar (separados por vírgula)
FRAME_ADMIN_EMAILS=
