# ═══════════════════════════════════════════════════════════════
# OFERTA AI — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env.
# ═══════════════════════════════════════════════════════════════

# --- Banco de dados (docker compose) ---
POSTGRES_USER=oferta
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=oferta_ai
# Para rodar fora do Docker:
DATABASE_URL=postgresql://oferta:troque-esta-senha@localhost:5432/oferta_ai
# Opcional. Sem REDIS_URL a plataforma roda em modo agendado (serverless): os agentes
# são acionados por POST /api/cron/run (ex.: pg_cron do Supabase) com o cabeçalho x-cron-secret.
REDIS_URL=redis://localhost:6379
CRON_SECRET=

# --- Segurança ---
# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h
# openssl rand -base64 32   (criptografa credenciais salvas pelo painel)
ENCRYPTION_KEY=
CORS_ORIGIN=http://localhost:3000
# false somente se acessar o painel sem HTTPS (ex.: teste local)
COOKIE_SECURE=true

# --- Administrador inicial (criado na primeira inicialização) ---
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# --- Operação ---
# sandbox = ambiente de testes com produtos FICTÍCIOS (nunca publica)
# live    = Shopee real (exige credenciais aprovadas)
DATA_MODE=sandbox
TZ_APP=America/Sao_Paulo
PORT=4000
LOG_LEVEL=info
# URL pública da API (ex.: https://api.seudominio.com). Ativa o rastreamento de cliques via /r/:code
PUBLIC_BASE_URL=

# --- Shopee Affiliate Open API (affiliate.shopee.com.br → Open API) ---
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql
SHOPEE_SUB_ID=ofertaai

# --- IA dos agentes (Claude API) — opcional; sem chave, Copywriter usa template com dados reais ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_FALLBACK_MODELS=claude-sonnet-5-5,claude-haiku-5-5
AI_EFFORT=low

# --- WhatsApp Business Platform (Cloud API + Groups API) ---
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# ID de um grupo CRIADO PELA GROUPS API (grupos do app não são suportados)
WHATSAPP_GROUP_ID=

# --- Telegram Bot API (canal alternativo oficial) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
