# Servidor
PORT=8787
NODE_ENV=development
CORS_ORIGINS=
RATE_LIMIT_PER_MIN=60
# Banco (Supabase Postgres). Ausente = memória (não persiste)
DATABASE_URL=
# Schema dedicado em banco compartilhado (use pooler em modo sessão, porta 5432)
DATABASE_SCHEMA=jarvis
# Auth Supabase (um dos dois)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Modo pessoal (um dono): token longo, ex.: openssl rand -base64 48
JARVIS_OWNER_TOKEN=
JARVIS_OWNER_ID=owner
# Só desenvolvimento local
JARVIS_DEV_TOKEN=
# 32 bytes em base64 (obrigatória em produção): openssl rand -base64 32
JARVIS_ENCRYPTION_KEY=
# IA — configure ao menos um provedor
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Tiers no formato provedor:modelo (opcional)
JARVIS_MODEL_FAST=
JARVIS_MODEL_BALANCED=
JARVIS_MODEL_DEEP=
AI_DAILY_BUDGET_USD=1
MODEL_PRICES_JSON=
# Google (Gmail/Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
